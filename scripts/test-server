#!/usr/bin/env bash
# Explicit live prerequisites: missing services fail instead of silently skipping integrations.
set -euo pipefail
: "${FOYER_TEST_DATABASE_URL:?Point at a disposable PostgreSQL database}"
: "${FOYER_DAV_URL:?Point at an isolated Radicale instance}"
: "${FOYER_DAV_USERNAME:?Set the isolated DAV username}"
: "${FOYER_DAV_PASSWORD:?Set the isolated DAV password}"
cd "$(dirname "$0")/../services/server"
cargo fmt -- --check
cargo test --locked -- --test-threads=1
