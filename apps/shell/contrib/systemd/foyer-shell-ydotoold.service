[Unit]
Description=Foyer Shell keyboard injection service
PartOf=graphical-session.target
After=graphical-session.target
Before=foyer-shell.service
ConditionPathExists=/dev/uinput

[Service]
Type=simple
RuntimeDirectory=foyer-shell
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/ydotoold --socket-path=%t/foyer-shell/ydotoold.sock --socket-perm=0600 --mouse-off
Restart=on-failure
RestartSec=1
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
