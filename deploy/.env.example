# Development-only Compose values. Copy to deploy/.env and change the secrets
# before exposing anything beyond localhost. These defaults fail closed outside
# FOYER_SERVER_ENV=development.

FOYER_DOMAIN=localhost
FOYER_SERVER_ENV=development
FOYER_DEV_USER_ID=dev-user
FOYER_DEV_TOKEN=foyer-dev-token-do-not-use-outside-development
# Optional local-only identities for isolation tests, formatted as user_id=token;...
FOYER_DEV_EXTRA_USERS=other-user=foyer-other-dev-token-do-not-use-outside-development
# Development generates an ephemeral ES256 key when this path is empty.
# In Compose production, put the PEM under FOYER_SECRETS_DIR and use its
# container path, for example /run/secrets/foyer/token-signing.pem.
FOYER_AUTH_SIGNING_KEY_PATH=
FOYER_SECRETS_DIR=./secrets
FOYER_AUTH_KEY_ID=foyer-dev
FOYER_AUTH_ISSUER=foyer-server
FOYER_AUTH_API_AUDIENCE=foyer-api
FOYER_POWERSYNC_URL=http://127.0.0.1:8080
FOYER_POWERSYNC_AUDIENCE=foyer-powersync
# Insecure local-only Radicale service credential. Foyer clients never receive it.
FOYER_DAV_URL=http://radicale:5232
FOYER_DAV_USERNAME=foyer
FOYER_DAV_PASSWORD=foyer-dev-dav-password-do-not-use-outside-development
# Production override: path to a private bcrypt htpasswd. Development uses users.dev.
# RADICALE_HTPASSWD_FILE=/secure/path/users

POSTGRES_DATABASE=foyer
POSTGRES_USER=foyer
POSTGRES_PASSWORD=foyer-dev-postgres-password
POWERSYNC_REPLICATION_PASSWORD=foyer-dev-powersync-replication-password
POWERSYNC_STORAGE_PASSWORD=foyer-dev-powersync-storage-password

RUST_LOG=info
COMPOSE_PROFILES=
