{
  "description": "Foyer HTTPS only",
  "enabled": true,
  "expression": "(http.host eq \"foyer.amoghs.net\" and not ssl)",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 308,
      "target_url": {
        "expression": "concat(\"https://foyer.amoghs.net\", http.request.uri.path)"
      },
      "preserve_query_string": true
    }
  }
}
