# Portable backup/restore configuration. Copy to a host-only file such as
# /etc/foyer/backup.env or deploy/backup/.local/backup.env. This file is not
# loaded by the main Compose stack.
#
# Backup jobs receive only the public age recipient. The recovery identity is
# offline and is used only for restore, verify, and the local drill.

# age1... public recipient. Never put a recovery identity here.
FOYER_BACKUP_AGE_RECIPIENT=

# Generic S3-compatible object store. The same variables work for R2, AWS S3,
# Hetzner Object Storage, MinIO, and any other SigV4 endpoint. There is no
# provider-specific format or API.
# The backup container uses this URL. For the local MinIO profile that is
# http://minio:9000. The same server is published on the host as
# http://127.0.0.1:19000 for browsers and manual inspection only.
FOYER_BACKUP_S3_ENDPOINT=http://minio:9000
FOYER_BACKUP_S3_REGION=us-east-1
FOYER_BACKUP_S3_BUCKET=foyer-backups
FOYER_BACKUP_S3_PREFIX=foyer/
FOYER_BACKUP_S3_ACCESS_KEY=
FOYER_BACKUP_S3_SECRET_KEY=
# Optional temporary credential.
# FOYER_BACKUP_S3_SESSION_TOKEN=
# path (default) works with custom endpoints. virtual is optional.
FOYER_BACKUP_S3_ADDRESSING=path

# Development or bind-mounted production: narrow host directory of signing
# keys and required secret files. The backup job copies regular files from
# this directory only.
FOYER_BACKUP_SECRETS_DIR=/var/lib/foyer/secrets

# Image-pulling production Compose stores these files in the foyer-secrets
# named volume already mounted by the backup service. In that deployment,
# remove FOYER_BACKUP_SECRETS_DIR and enable this instead:
# FOYER_BACKUP_USE_COMPOSE_SECRETS=1

# Point the host wrapper at a non-development Compose deployment. Dokploy may
# override the top-level Compose project name; use the project label shown by
# `docker compose ls` so the wrapper quiesces the existing containers.
# FOYER_COMPOSE_FILE=/opt/foyer/deploy/compose.production.yaml
# FOYER_COMPOSE_ENV_FILE=/etc/foyer/production.env
# FOYER_COMPOSE_PROJECT_NAME=foyer

# Canonical PostgreSQL (logical dump). Password is read from the environment
# or from FOYER_BACKUP_POSTGRES_PASSWORD_FILE; never pass it as an argument.
FOYER_BACKUP_POSTGRES_HOST=postgres
FOYER_BACKUP_POSTGRES_PORT=5432
FOYER_BACKUP_POSTGRES_DB=foyer
FOYER_BACKUP_POSTGRES_USER=foyer
# FOYER_BACKUP_POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# Restore is opt-in and requires explicit targets. Isolated mode is only for
# the Compose backup-test volumes and never the live development volumes.
# FOYER_RESTORE_ISOLATED=0
# FOYER_RESTORE_POSTGRES_HOST=restore-test-postgres
# FOYER_RESTORE_RADICALE_DIR=/restore/radicale
# FOYER_RESTORE_SECRETS_DIR=/restore/secrets
# FOYER_BACKUP_AGE_IDENTITY_FILE=/secure/offline/age-identity.txt

# Host lock. Backup and restore are mutually exclusive.
# FOYER_BACKUP_LOCK_FILE=/run/lock/foyer-backup.lock
