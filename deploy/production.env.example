# Generate real values with:
#   ./deploy/scripts/generate-production-env.sh
# Paste the generated block into the Dokploy Compose service's Environment tab.

FOYER_IMAGE_REGISTRY=ghcr.io/amoghsolomon/foyer
FOYER_IMAGE_VERSION=main
FOYER_EDGE_NETWORK=dokploy-network

POSTGRES_DATABASE=foyer
POSTGRES_USER=foyer
POSTGRES_PASSWORD=
POWERSYNC_REPLICATION_PASSWORD=
POWERSYNC_STORAGE_PASSWORD=

FOYER_DAV_PASSWORD=
FOYER_AUTH_KEY_ID=
FOYER_AUTH_ISSUER=https://api.foyer.i0t.in
FOYER_AUTH_API_AUDIENCE=foyer-api
FOYER_POWERSYNC_URL=https://sync.foyer.i0t.in
FOYER_POWERSYNC_AUDIENCE=foyer-powersync
RUST_LOG=info

FOYER_BACKUP_USE_COMPOSE_SECRETS=1
FOYER_BACKUP_REQUIRE_EXPLICIT_S3=1

# Add these later when the R2 bucket and offline age recipient exist.
# FOYER_BACKUP_AGE_RECIPIENT=age1...
# FOYER_BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# FOYER_BACKUP_S3_REGION=auto
# FOYER_BACKUP_S3_BUCKET=foyer-backups
# FOYER_BACKUP_S3_PREFIX=foyer/
# FOYER_BACKUP_S3_ACCESS_KEY=
# FOYER_BACKUP_S3_SECRET_KEY=
# FOYER_BACKUP_S3_ADDRESSING=path
